{
  "vhosts": [
    { "name": "/" }
  ],
  "users": [
    {
      "name": "appuser",
      "password": "apppass",
      "tags": "administrator"
    }
  ],
  "permissions": [
    {
      "user": "appuser",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "queues": [
    {
      "name": "inventory_queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "exchanges": [
    {
      "name": "order_exchange",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "order_exchange",
      "vhost": "/",
      "destination": "inventory_queue",
      "destination_type": "queue",
      "routing_key": "order.created",
      "arguments": {}
    }
  ]
}
